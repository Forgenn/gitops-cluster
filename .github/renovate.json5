{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':separatePatchReleases',
    ':semanticCommits',
  ],
  timezone: 'Europe/Madrid',
  schedule: [
    'after 3am and before 6am on monday',
  ],
  labels: [
    'renovate',
  ],
  reviewers: [
    'Forgenn',
  ],
  commitMessagePrefix: 'chore(deps):',
  // Renovate no longer merges anything. It had automergeType 'branch' with the
  // default ignoreTests:false, so it waited for a status check that this repo
  // never produced -- zero dependency commits landed between April and
  // September 2026. Rather than teach Renovate to merge, merge authority now
  // sits in exactly one place: the homelab-ops update-review job, which reads
  // the labels below as its risk signal. Two independent mergers would mean
  // two audit trails. See docs/plans/2026-09-20-fleet-update-automation.md
  vulnerabilityAlerts: {
    enabled: true,
    addLabels: [
      'security',
    ],
  },
  packageRules: [
    {
      description: 'Ignore internal loomie images (managed by CI, not Renovate)',
      enabled: false,
      matchPackageNames: [
        '/^registry\\.monederobox\\.dev//',
      ],
    },
    {
      description: 'Lidarr nightly and Readarr develop are intentional floating tags',
      matchPackageNames: [
        'lscr.io/linuxserver/lidarr',
        'lscr.io/linuxserver/readarr',
      ],
      enabled: false,
    },
    {
      description: 'Core infrastructure requires manual review',
      matchPackageNames: [
        'argo-cd',
        'cert-manager',
        'external-secrets',
        'longhorn',
        'cloudnative-pg',
        'kube-prometheus-stack',
        'democratic-csi',
        'snapshot-controller',
        'gateway-helm',
        'volsync',
      ],
      // addLabels, not labels: `labels` REPLACES the set, so a later matching
      // rule would silently drop 'core-infra' -- and that label is what keeps
      // core infra out of the auto-merge tier.
      addLabels: [
        'core-infra',
      ],
      minimumReleaseAge: '3 days',
    },
    {
      description: 'Label helm chart minor updates',
      matchManagers: [
        'kustomize',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'helm-minor',
      ],
    },
    {
      description: 'Label helm chart major updates, low priority',
      matchManagers: [
        'kustomize',
      ],
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'helm-major',
      ],
      prPriority: -1,
    },
    {
      description: 'Group *arr suite updates into one PR',
      matchPackageNames: [
        'lscr.io/linuxserver/prowlarr',
        'lscr.io/linuxserver/qbittorrent',
      ],
      groupName: 'arr-suite',
      addLabels: [
        'group:arr-suite',
      ],
    },
    {
      description: 'Group media app image updates',
      matchPackageNames: [
        'deluan/navidrome',
        'ghcr.io/suwayomi/suwayomi-server',
        'ghcr.io/kareadita/kavita',
      ],
      groupName: 'media-apps',
      addLabels: [
        'group:media-apps',
      ],
    },
    {
      description: 'Wait 2 days after release before raising a PR',
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      minimumReleaseAge: '2 days',
    },
    // Classification labels. The update-review policy matches on these and
    // nothing else -- it never parses a branch name or a PR title. Keep these
    // rules last so addLabels applies on top of every rule above.
    {
      description: 'Classification label: patch',
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'patch',
      ],
    },
    {
      description: 'Classification label: minor',
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'minor',
      ],
    },
    {
      description: 'Classification label: major',
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'major',
      ],
    },
    {
      description: 'Classification label: digest',
      matchUpdateTypes: [
        'digest',
      ],
      addLabels: [
        'digest',
      ],
    },
  ],
  'helm-values': {
    managerFilePatterns: [
      '/infra/.+/values/.+\\.yaml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Docker image tags in raw Deployment manifests',
      managerFilePatterns: [
        '/infra/.+/deployment\\.yaml$/',
        '/infra/.+/navidrome-deployment\\.yaml$/',
      ],
      matchStrings: [
        'image:\\s+(?<depName>[a-z0-9._\\-/]+):(?<currentValue>[a-zA-Z0-9._\\-]+)',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'CNPG postgresql image versions in cluster YAML files',
      managerFilePatterns: [
        '/infra/.+\\.yaml$/',
      ],
      matchStrings: [
        'imageName:\\s+(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[a-zA-Z0-9._\\-]+)',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
  ],
  ignorePaths: [
    // Bundled upstream chart files (contain non-ASCII in CRD templates / READMEs)
    'infra/cert-manager/charts/**',
    'infra/opencloud/charts/**',
    // Markdown docs with Unicode arrows/em-dashes - not dependency files
    '**/CLAUDE.md',
    '**/README.md',
    '**/docs/**',
    // Internal/generated paths
    '**/loomie-sandbox/**',
    '**/scripts/**',
    'infra/loomie/backend/**',
    'infra/loomie/frontend/**',
    'infra/loomie/sidecar/**',
  ],
}
