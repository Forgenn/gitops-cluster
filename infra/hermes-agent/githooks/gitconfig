# System git config for the hermes-agent container (mounted at /etc/gitconfig).
# Every repository the agent touches runs /etc/hermes-githooks/pre-push.
[core]
	hooksPath = /etc/hermes-githooks
# GitHub over HTTPS, two helpers tried in order (phase 2 Task 3):
# 1. the forgenn-hermes App token, answering only for repos the App is installed on
#    (useHttpPath hands the helper the repo path);
# 2. the developer bot's fine-grained PAT, which answers only inside a developer-scoped
#    terminal (see git_credential_developer_pat.py) -- side projects outside the App.
[credential "https://github.com"]
	helper = /etc/hermes-githooks/git-credential-github-app
	helper = /etc/hermes-githooks/git-credential-developer-pat
	useHttpPath = true
# Every GitHub SSH remote, including the old per-repo deploy-key aliases, goes over
# HTTPS with the App token. The plder read-only sync alias (github.com-plder) is
# deliberately not rewritten.
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
	insteadOf = git@github.com-nixos:
	insteadOf = git@github.com-plder-write:
